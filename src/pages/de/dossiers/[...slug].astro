---
import DossierPage from "../../../components/DossierPage.astro";
import { publishedDossiers } from "../../../lib/news";

export async function getStaticPaths() {
  const dossiers = await publishedDossiers("de");
  return dossiers.map((dossier) => ({ params: { slug: dossier.data.slug }, props: { dossier } }));
}
const { dossier } = Astro.props;
---
<DossierPage lang="de" dossier={dossier} />
