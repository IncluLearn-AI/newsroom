---
import ArticlePage from "../../../components/ArticlePage.astro";
import { publishedNews } from "../../../lib/news";

export async function getStaticPaths() {
  const posts = await publishedNews("de");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<ArticlePage lang="de" post={post} />
