---
const target = import.meta.env.BASE_URL + "en/news/from-research-to-validated-requirements/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <title>Redirect · IncluLearn.AI Newsroom</title>
  </head>
  <body>
    <p><a href={target}>Go to the updated post</a></p>
  </body>
</html>
