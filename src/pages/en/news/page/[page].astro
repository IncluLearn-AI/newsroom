---
import NewsIndexPage from "../../../../components/NewsIndexPage.astro";
import { publishedNews } from "../../../../lib/news";

export async function getStaticPaths() {
  const pageSize = 20;
  const count = (await publishedNews("en")).length;
  const totalPages = Math.max(1, Math.ceil(count / pageSize));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page, pageSize } };
  });
}

const { page, pageSize } = Astro.props;
---
<NewsIndexPage lang="en" page={page} pageSize={pageSize} />
