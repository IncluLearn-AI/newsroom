---
import TopicPage from "../../../components/TopicPage.astro";
import { categorySlug, type Category } from "../../../lib/i18n";

export function getStaticPaths() {
  const categories: Category[] = ["project-progress", "research-radar", "tools-transfer", "publications-events"];
  return categories.map((category) => ({
    params: { category: categorySlug("en", category) },
    props: { category }
  }));
}
const { category } = Astro.props;
---
<TopicPage lang="en" category={category} />
