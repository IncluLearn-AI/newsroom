---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("news")).filter((entry) => !entry.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={\`\${post.data.title} · IncluLearn.AI Newsroom\`} description={post.data.summary}>
  <article class="shell article">
    <p class="eyebrow">{post.data.category}</p>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.summary}</p>
    <p class="meta">
      <time datetime={post.data.published.toISOString()}>
        {post.data.published.toLocaleDateString("de-DE")}
      </time>
      {" · Evidenz: "}
      {post.data.evidence}
    </p>

    <Content />

    {post.data.sourceUrl && (
      <section aria-labelledby="quelle">
        <h2 id="quelle">Quelle</h2>
        <p>
          <a href={post.data.sourceUrl}>
            {post.data.sourceLabel ?? "Primärquelle öffnen"}
          </a>
        </p>
      </section>
    )}
  </article>
</BaseLayout>
