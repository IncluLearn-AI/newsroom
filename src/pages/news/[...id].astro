---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("news")).filter((entry) => !entry.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title + " · IncluLearn.AI Newsroom"} description={post.data.summary}>
  <article class="shell article">
    <p class="eyebrow">{post.data.category}</p>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.summary}</p>
    <p class="meta">
      <time datetime={post.data.published.toISOString()}>
        {post.data.published.toLocaleDateString("de-DE")}
      </time>
      {" · Evidenz: "}
      {post.data.evidence}
      {post.data.updated && (
        <>
          {" · aktualisiert "}
          <time datetime={post.data.updated.toISOString()}>
            {post.data.updated.toLocaleDateString("de-DE")}
          </time>
        </>
      )}
    </p>

    {post.data.aiAssisted && (
      <p class="notice">
        Dieser Beitrag wurde KI-gestützt recherchiert oder redaktionell vorbereitet und vor der Veröffentlichung menschlich geprüft.
      </p>
    )}

    <Content />

    {post.data.sources.length > 0 && (
      <section aria-labelledby="quellen">
        <h2 id="quellen">Quellen</h2>
        <ol class="source-list">
          {post.data.sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
              <span class="meta">
                {" — "}
                {source.kind}
                {source.published && (
                  <>
                    {", "}
                    <time datetime={source.published.toISOString()}>
                      {source.published.toLocaleDateString("de-DE")}
                    </time>
                  </>
                )}
                {source.doi && <> · DOI: {source.doi}</>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</BaseLayout>
