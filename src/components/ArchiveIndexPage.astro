---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archiveMonthPath, pathFor, ui, type Locale } from "../lib/i18n";
import { archiveYearPath, eventDate, publishedNews } from "../lib/news";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const posts = await publishedNews(lang);

const years = new Map<number, { count: number; months: Map<number, number> }>();
for (const post of posts) {
  const date = eventDate(post);
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth() + 1;
  const bucket = years.get(year) ?? { count: 0, months: new Map<number, number>() };
  bucket.count += 1;
  bucket.months.set(month, (bucket.months.get(month) ?? 0) + 1);
  years.set(year, bucket);
}

const items = [...years.entries()].sort(([a], [b]) => b - a);
const monthName = (year: number, month: number) => new Intl.DateTimeFormat(lang === "de" ? "de-DE" : "en-GB", {
  month: "long",
  timeZone: "UTC"
}).format(new Date(Date.UTC(year, month - 1, 1)));
---

<BaseLayout
  lang={lang}
  title={`${copy.archiveHeading} · IncluLearn.AI Newsroom`}
  description={copy.archiveLead}
  canonicalPath={pathFor(lang, "archive")}
  alternatePaths={{ de: pathFor("de", "archive"), en: pathFor("en", "archive") }}
>
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">{copy.archive}</p>
        <h1>{copy.archiveHeading}</h1>
        <p class="lead">{copy.archiveLead}</p>
        <p>{lang === "de"
          ? "Das Archiv ist nach dem tatsächlichen Ereigniszeitraum organisiert. Für größere Mengen führen Jahresseiten zu den einzelnen Monaten."
          : "The archive is organised by actual event period. For larger volumes, yearly pages lead to individual months."}</p>
      </div>

      {items.length === 0 ? <p>{copy.noPosts}</p> : (
        <div class="archive-years">
          {items.map(([year, info]) => {
            const months = [...info.months.entries()].sort(([a], [b]) => b - a);
            return (
              <section class="archive-year-card" aria-labelledby={`archive-year-${year}`}>
                <div class="archive-year-head">
                  <h2 id={`archive-year-${year}`}><a href={href(archiveYearPath(lang, year))}>{year}</a></h2>
                  <span class="meta">{info.count} {lang === "de" ? (info.count === 1 ? "Beitrag" : "Beiträge") : (info.count === 1 ? "post" : "posts")}</span>
                </div>
                <ol class="archive-month-grid">
                  {months.map(([month, count]) => (
                    <li>
                      <a href={href(archiveMonthPath(lang, year, month))}>{monthName(year, month)}</a>
                      <span class="meta">{count}</span>
                    </li>
                  ))}
                </ol>
              </section>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>