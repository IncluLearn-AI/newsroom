---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "IncluLearn.AI Newsroom",
  description = "Projektfortschritt, Research Radar und Transfer rund um IncluLearn.AI."
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={base} aria-label="IncluLearn.AI Newsroom – Startseite">
          <span class="brand-mark" aria-hidden="true">IL</span>
          <span>
            <strong>IncluLearn.AI</strong>
            <small>Newsroom & Research Radar</small>
          </span>
        </a>
        <nav aria-label="Hauptnavigation">
          <a href={\`\${base}news/\`}>Beiträge</a>
          <a href="https://inclulearn-test.owli-ai.com/">Demo</a>
          <a href="https://github.com/IncluLearn-AI">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="shell footer-inner">
        <p><strong>IncluLearn.AI</strong> – KI-gestützte Generierung barrierefreier MINT-Lehrmaterialien.</p>
        <p>Inhalte werden text-first, quellengestützt und nach menschlichem Review veröffentlicht.</p>
      </div>
    </footer>
  </body>
</html>
